{
  "info": {
    "_postman_id": "32ca05e0-976e-475a-8380-4339432b9416",
    "name": "Airmeet Public Authentication Manage Event Series API",
    "description": "The Airmeet Public API lets you programmatically manage events (Airmeets), registrations, sessions, speakers, booths and event series on the Airmeet virtual, hybrid and in-person events platform, and read back event engagement and attendance data. Authentication is a two-step flow: exchange an access key and secret key at POST /auth for a bearer access token (valid 30 days), then send that token as the X-Airmeet-Access-Token header on every other request. Several read endpoints (attendees, booth attendance, UTMs, replay attendance) are asynchronous and return a job/URL to poll for the result. Responses share a { \"success\": boolean, \"data\": ... } envelope.\n\nContact Support:\n Name: Airmeet Support\n Email: support@airmeet.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T00:29:21.000Z",
    "updatedAt": "2026-07-28T00:29:21.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-32ca05e0-976e-475a-8380-4339432b9416"
  },
