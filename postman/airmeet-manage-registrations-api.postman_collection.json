                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"email\": \"<email>\",\n  \"firstName\": \"<string>\",\n  \"lastName\": \"<string>\",\n  \"attendance_type\": \"VIRTUAL\",\n  \"city\": \"<string>\",\n  \"country\": \"<string>\",\n  \"designation\": \"<string>\",\n  \"organisation\": \"<string>\",\n  \"registerAttendee\": false,\n  \"sendEmailInvite\": true,\n  \"customFieldMapping\": [\n    {\n      \"fieldId\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"fieldId\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ]\n}",
